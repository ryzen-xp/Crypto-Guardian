# ─── Venice AI ───────────────────────────────────────────
# Primary AI — get key at venice.ai/settings/api
VENICE_API_KEY=your_venice_api_key

# ─── Free AI fallbacks ───────────────────────────────────
# Groq: free, no card — console.groq.com (14,400 req/day)
GROQ_API_KEY=your_groq_key

# Gemini: free, no card — aistudio.google.com/apikey (1,000 req/day)
GEMINI_API_KEY=your_gemini_key

# ─── MetaMask / WalletConnect ────────────────────────────
NEXT_PUBLIC_WALLET_CONNECT_ID=your_walletconnect_project_id

# ─────────────────────────────────────────────────────────
# ETHEREUM SEPOLIA TESTNET (default for development)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=sepolia
NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.etherscan.io
NEXT_PUBLIC_IS_TESTNET=true

# Circle USDC on Ethereum Sepolia — faucet.circle.com
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Uniswap v3 SwapRouter02 on Ethereum Sepolia
NEXT_PUBLIC_UNISWAP_ROUTER=0x3bFA4769FB09eefC5a80d6E87c3B9C650f7Ae48

# ─────────────────────────────────────────────────────────
# ETHEREUM MAINNET (production — swap out the above)
# ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_CHAIN_ID=1
# NEXT_PUBLIC_CHAIN_NAME=mainnet
# NEXT_PUBLIC_RPC_URL=https://eth.llamarpc.com
# NEXT_PUBLIC_EXPLORER_URL=https://etherscan.io
# NEXT_PUBLIC_IS_TESTNET=false
# NEXT_PUBLIC_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# NEXT_PUBLIC_UNISWAP_ROUTER=0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45

# ─── 1Shot API ───────────────────────────────────────────
ONESHOT_API_KEY=your_oneshot_api_key
ONESHOT_API_URL=https://api.1shotapi.com
ONESHOT_WEBHOOK_SECRET=your_webhook_secret

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
