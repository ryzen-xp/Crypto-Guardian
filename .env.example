# ─── Venice AI ───────────────────────────────────────────
VENICE_API_KEY=your_venice_api_key

# ─── MetaMask / WalletConnect ────────────────────────────
NEXT_PUBLIC_WALLET_CONNECT_ID=your_walletconnect_project_id

# ─────────────────────────────────────────────────────────
# BASE SEPOLIA TESTNET (default for development)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_CHAIN_NAME=baseSepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_IS_TESTNET=true

# Circle USDC on Base Sepolia — get test USDC at faucet.circle.com
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Uniswap v3 SwapRouter on Base Sepolia
NEXT_PUBLIC_UNISWAP_ROUTER=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4

# ─────────────────────────────────────────────────────────
# BASE MAINNET (production — uncomment and remove testnet lines above)
# ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_CHAIN_ID=8453
# NEXT_PUBLIC_CHAIN_NAME=base
# NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
# NEXT_PUBLIC_EXPLORER_URL=https://basescan.org
# NEXT_PUBLIC_IS_TESTNET=false
# NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# NEXT_PUBLIC_UNISWAP_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481

# ─── 1Shot API ───────────────────────────────────────────
ONESHOT_API_KEY=your_oneshot_api_key
ONESHOT_API_URL=https://api.1shotapi.com
ONESHOT_WEBHOOK_SECRET=your_webhook_secret

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=random_32_char_string

# ─── Feature flags ───────────────────────────────────────
# true  = show demo verdicts + real prices, mock swap execution (safe for testnet)
# false = full live mode (mainnet only)
NEXT_PUBLIC_DEMO_MODE=true
